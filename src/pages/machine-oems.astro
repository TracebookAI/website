<!-- ─── CHAT REPLAY · vanilla JS ──────────────────────────────────── -->
<script is:inline>
(function () {
  const root      = document.getElementById('chat-body');
  const replay    = document.getElementById('chat-replay');
  const status    = document.getElementById('chat-status');
  const machineEl = document.getElementById('chat-machine');
  if (!root) return;

  // Source-type → small glyph + label for the citation chip tooltip.
  const SOURCE_META = {
    manual:           { glyph: '📘', label: 'Manual' },
    drawing:          { glyph: '📐', label: 'Drawing' },
    historical_case:  { glyph: '🗂',  label: 'Historical case' },
    youtube:          { glyph: '▶',  label: 'YouTube' },
    document:         { glyph: '📄', label: 'Document' },
  };

  let abortToken = 0;        // increments to abort an in-flight playthrough
  let conversation = null;

  // ─── element factories ─────────────────────────────────────────
  function el(tag, cls, html) {
    const e = document.createElement(tag);
    if (cls)  e.className = cls;
    if (html != null) e.innerHTML = html;
    return e;
  }

  // ─── markdown-ish rendering — inline bold + line breaks + lists
  function renderMd(text) {
    // Bold **x** → <strong>x</strong>
    let out = text.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
    // Numbered lines → <ol> if any begin with "1. ", "2. ", etc.
    if (/^\s*\d+\.\s/m.test(out)) {
      const lines = out.split('\n');
      let html = '', inList = false;
      for (const line of lines) {
        const m = line.match(/^\s*\d+\.\s+(.+)$/);
        if (m) {
          if (!inList) { html += '<ol class="ml-5 list-decimal space-y-1 my-2">'; inList = true; }
          html += `<li>${m[1]}</li>`;
        } else {
          if (inList) { html += '</ol>'; inList = false; }
          if (line.trim()) html += `<p class="my-2">${line}</p>`;
          else if (html && !html.endsWith('</p>')) html += '';
        }
      }
      if (inList) html += '</ol>';
      return html;
    }
    return out.split('\n\n').map(p => `<p class="my-2 first:mt-0 last:mb-0">${p.replace(/\n/g,'<br>')}</p>`).join('');
  }

  function userBubble() {
    const wrap = el('div', 'flex justify-end');
    const b = el('div',
      'max-w-[80%] rounded-md border border-ink/25 bg-paperDeep px-4 py-2.5 text-sm leading-relaxed text-ink');
    wrap.appendChild(b);
    return { wrap, body: b };
  }

  function assistantBubble() {
    const wrap = el('div', 'flex flex-col items-start gap-2');
    const meta = el('div',
      'flex items-center gap-2 font-mono text-[10px] uppercase tracking-eyebrow text-inkMute');
    meta.innerHTML = '<span>Tracebook AI</span>';
    const b = el('div',
      'max-w-[88%] rounded-md bg-paper px-4 py-3 text-[15px] leading-relaxed text-ink shadow-[0_1px_0_rgba(26,26,26,0.06)]');
    wrap.appendChild(meta);
    wrap.appendChild(b);
    return { wrap, body: b };
  }

  function citationsRow(citations) {
    const row = el('div', 'mt-2 flex flex-wrap gap-2');
    citations.forEach(c => {
      const meta = SOURCE_META[c.type] || { glyph: '◦', label: c.type };
      const chip = el('span',
        'inline-flex items-center gap-1.5 rounded-full border border-gold bg-goldSoft/60 px-2.5 py-1 text-[11px] font-mono text-ink',
        `<span class="font-bold">${c.n}</span><span class="opacity-70">${meta.glyph}</span><span>${c.title}${c.page ? ' · ' + c.page : ''}</span>`);
      row.appendChild(chip);
    });
    return row;
  }

  function thinkingDots() {
    const wrap = el('div', 'flex items-center gap-1.5 px-1 py-2');
    for (let i = 0; i < 3; i++) {
      const dot = el('span',
        'h-1.5 w-1.5 rounded-full bg-inkMute animate-pulse',
        '');
      dot.style.animationDelay = (i * 200) + 'ms';
      wrap.appendChild(dot);
    }
    return wrap;
  }

  // ─── animation helpers ─────────────────────────────────────────
  function sleep(ms, token) {
    return new Promise(r => setTimeout(() => r(token === abortToken), ms));
  }

  // Stream text into target by chunking — faster than per-char so the
  // viewer absorbs at reading pace without it dragging.
  async function streamText(target, fullHtml, token) {
    // Render the full HTML invisibly to determine character count, then
    // reveal progressively. Simpler approach: just set innerHTML at the
    // end after a "typing" beat. Cleaner read on landing pages.
    target.innerHTML = '';
    target.style.opacity = '0';
    target.innerHTML = fullHtml;
    // Two-phase reveal: opacity 0→1 over ~280ms.
    await sleep(40, token);
    if (token !== abortToken) return;
    target.style.transition = 'opacity 320ms ease-out';
    target.style.opacity = '1';
    await sleep(320, token);
  }

  // ─── main loop ─────────────────────────────────────────────────
  async function play(token) {
    root.innerHTML = '';
    if (replay) replay.classList.add('hidden');

    for (const turn of conversation.turns) {
      if (token !== abortToken) return;

      await sleep(turn.delay_ms || 700, token);
      if (token !== abortToken) return;

      if (turn.role === 'user') {
        const { wrap, body } = userBubble();
        root.appendChild(wrap);
        body.innerHTML = turn.text;
        scrollPin();
        await sleep(280, token);
      } else {
        const { wrap, body } = assistantBubble();
        const dots = thinkingDots();
        body.appendChild(dots);
        root.appendChild(wrap);
        scrollPin();
        await sleep(turn.thinking_ms || 1800, token);
        if (token !== abortToken) return;
        body.innerHTML = '';
        await streamText(body, renderMd(turn.text), token);
        if (turn.citations && turn.citations.length) {
          await sleep(180, token);
          if (token !== abortToken) return;
          body.appendChild(citationsRow(turn.citations));
        }
        if (turn.resolved) {
          if (status) status.textContent = '✓ resolved · cited from your library';
        }
        scrollPin();
      }
    }

    if (replay) replay.classList.remove('hidden');
  }

  function scrollPin() {
    root.scrollTop = root.scrollHeight;
  }

  // ─── kick off ──────────────────────────────────────────────────
  // Read the transcript from the inline <script is:inline type="application/json">
  // tag rather than fetching it. fetch() doesn't work on the file://
  // protocol (browsers block it for security), so inlining keeps the
  // page working when opened by double-click as well as when served.
  try {
    const node = document.getElementById('chat-transcript');
    conversation = JSON.parse(node.textContent);
    if (machineEl && conversation.machine) {
      machineEl.textContent =
        `${conversation.machine.model} · #${conversation.machine.serial}`;
    }
    // Start when the chat is in view, not on page load — feels more
    // like the visitor is "watching it happen".
    const obs = new IntersectionObserver((entries) => {
      if (entries.some(e => e.isIntersecting)) {
        obs.disconnect();
        abortToken += 1;
        play(abortToken);
      }
    }, { threshold: 0.25 });
    obs.observe(document.getElementById('chat-demo'));
  } catch (err) {
    root.innerHTML =
      '<p class="text-sm text-inkMute italic px-2 py-4">Demo conversation could not be parsed: '
      + (err.message || err) + '</p>';
  }

  if (replay) {
    replay.addEventListener('click', () => {
      abortToken += 1;
      if (status) status.textContent = 'tracebook.support · acme manufacturing';
      play(abortToken);
    });
  }
})();
</script>


