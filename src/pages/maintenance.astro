---
import Base from '../layouts/Base.astro'
---
<Base title="Tracebook Maintenance — AI for internal maintenance teams">
<section class="relative overflow-hidden">
  <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
    <div class="font-mono text-xs font-bold uppercase tracking-eyebrow text-gold">
      &#8982; tracebook maintenance &middot; for factories
    </div>
    <h1 class="mt-6 max-w-3xl font-display text-5xl font-medium leading-[0.98] tracking-tight text-ink md:text-6xl">
      Your best tech retires. <em class="italic wonk">Their fixes don&rsquo;t.</em>
    </h1>
    <p class="mt-8 max-w-xl font-display italic text-lg leading-relaxed text-inkSoft md:text-xl">
      Operators report problems from the machine. Maintenance investigates
      with AI over every manual for every machine you own — and over every
      fix your own team ever wrote down. Multi-vendor fleet, one brain.
    </p>
  </div>
</section>

<!-- THE WORKFLOW -->
<section class="border-t border-ink/10 bg-paperDeep/40 py-24">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="font-display text-4xl font-medium leading-tight md:text-5xl">
      A problem&rsquo;s whole life, <em class="italic wonk">in one loop</em>
    </h2>
    <div class="mt-12 grid gap-8 md:grid-cols-3">
      <div class="rounded-lg border border-ink/10 bg-paper p-7">
        <div class="font-mono text-xs font-bold uppercase tracking-eyebrow text-gold">1 &middot; report</div>
        <h3 class="mt-3 font-display text-xl font-medium text-ink">A phone in a gloved hand</h3>
        <p class="mt-3 text-sm leading-relaxed text-inkSoft">
          The operator scans the QR label on the machine, types one line,
          snaps the fault screen. Ticket filed, machine attached, photo
          included — thirty seconds, no training.
        </p>
      </div>
      <div class="rounded-lg border border-ink/10 bg-paper p-7">
        <div class="font-mono text-xs font-bold uppercase tracking-eyebrow text-gold">2 &middot; investigate</div>
        <h3 class="mt-3 font-display text-xl font-medium text-ink">The tech asks the AI</h3>
        <p class="mt-3 text-sm leading-relaxed text-inkSoft">
          One click on the ticket opens an AI session that already knows
          the report — and what the photo shows. Answers cite the exact
          manual pages and past cases for that machine&rsquo;s configuration.
        </p>
      </div>
      <div class="rounded-lg border border-ink/10 bg-paper p-7">
        <div class="font-mono text-xs font-bold uppercase tracking-eyebrow text-gold">3 &middot; compound</div>
        <h3 class="mt-3 font-display text-xl font-medium text-ink">The fix teaches the system</h3>
        <p class="mt-3 text-sm leading-relaxed text-inkSoft">
          Resolving the ticket writes a knowledge-base case the AI
          retrieves next time. Tribal knowledge survives turnover,
          retirement, and the night shift.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- LIVE DEMO (placeholder until VM) -->
<section class="border-t border-ink/10 py-24">
  <div class="mx-auto max-w-3xl px-6 text-center">
    <h2 class="font-display text-4xl font-medium leading-tight md:text-5xl">
      Walk the loop yourself
    </h2>
    <p class="mx-auto mt-6 max-w-xl font-display italic text-lg text-inkSoft">
      The live demo plant — operator portal and technician portal with
      demo accounts — is coming online.
    </p>
    <div class="mt-8 inline-flex items-center gap-3 rounded-md border border-ink/15 bg-paperDeep/60 px-5 py-3 text-sm text-inkMute">
      <span class="font-mono text-xs uppercase tracking-small">live demo</span> coming online
    </div>
    <p class="mt-10 text-sm text-inkSoft">
      Can&rsquo;t wait? <a href="mailto:cmisztur@mriiot.com?subject=Tracebook%20Maintenance%20demo" class="font-medium text-ink underline decoration-gold decoration-2 underline-offset-4">Book fifteen minutes</a> and bring your worst recurring breakdown.
    </p>
  </div>
</section>
</Base>
