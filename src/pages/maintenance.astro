---
import Base from '../layouts/Base.astro'
---
<Base title="Tracebook Maintenance — AI for internal maintenance teams">
<section class="relative overflow-hidden">
  <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
    <div class="font-mono text-xs font-bold uppercase tracking-eyebrow text-gold">
      &#8982; tracebook maintenance &middot; for factories
    </div>
    <h1 class="mt-6 max-w-3xl font-display text-5xl font-medium leading-[0.98] tracking-tight text-ink md:text-6xl">
      Your best tech retires. <em class="italic wonk">Their fixes don&rsquo;t.</em>
    </h1>
    <p class="mt-8 max-w-xl font-display italic text-lg leading-relaxed text-inkSoft md:text-xl">
      Operators report problems from the machine. Maintenance investigates
      with AI over every manual for every machine you own — and over every
      fix your own team ever wrote down. Multi-vendor fleet, one brain.
    </p>
  </div>
</section>

<!-- THE WORKFLOW -->
<section class="border-t border-ink/10 bg-paperDeep/40 py-24">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="font-display text-4xl font-medium leading-tight md:text-5xl">
      A problem&rsquo;s whole life, <em class="italic wonk">in one loop</em>
    </h2>
    <div class="mt-12 grid gap-8 md:grid-cols-3">
      <div class="rounded-lg border border-ink/10 bg-paper p-7">
        <div class="font-mono text-xs font-bold uppercase tracking-eyebrow text-gold">1 &middot; report</div>
        <h3 class="mt-3 font-display text-xl font-medium text-ink">A phone in a gloved hand</h3>
        <p class="mt-3 text-sm leading-relaxed text-inkSoft">
          The operator scans the QR label on the machine, types one line,
          snaps the fault screen. Ticket filed, machine attached, photo
          included — thirty seconds, no training.
        </p>
      </div>
      <div class="rounded-lg border border-ink/10 bg-paper p-7">
        <div class="font-mono text-xs font-bold uppercase tracking-eyebrow text-gold">2 &middot; investigate</div>
        <h3 class="mt-3 font-display text-xl font-medium text-ink">The tech asks the AI</h3>
        <p class="mt-3 text-sm leading-relaxed text-inkSoft">
          One click on the ticket opens an AI session that already knows
          the report — and what the photo shows. Answers cite the exact
          manual pages and past cases for that machine&rsquo;s configuration.
        </p>
      </div>
      <div class="rounded-lg border border-ink/10 bg-paper p-7">
        <div class="font-mono text-xs font-bold uppercase tracking-eyebrow text-gold">3 &middot; compound</div>
        <h3 class="mt-3 font-display text-xl font-medium text-ink">The fix teaches the system</h3>
        <p class="mt-3 text-sm leading-relaxed text-inkSoft">
          Resolving the ticket writes a knowledge-base case the AI
          retrieves next time. Tribal knowledge survives turnover,
          retirement, and the night shift.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- LIVE DEMO — portals + demo accounts -->
<section class="border-t border-ink/10 py-24">
  <div class="mx-auto max-w-4xl px-6">
    <h2 class="text-center font-display text-4xl font-medium leading-tight md:text-5xl">
      Walk the loop yourself
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-center font-display italic text-lg text-inkSoft">
      Two portals, one demo plant. File a problem as the operator, then
      switch hats and investigate it with AI as the tech.
    </p>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <!-- Links carry the shared demo credentials as ?user=&pass= — the
           portal login pages pre-fill from them, so visitors just click
           Sign in. No need to display the account on this page. -->
      <a href="https://maintenance.demo.tracebook.ai/login?user=op%40demo.tracebook.ai&pass=password" target="_blank" rel="noreferrer"
         class="group rounded-lg border border-ink/15 bg-paper p-7 transition-shadow hover:shadow-lg">
        <div class="font-mono text-[11px] font-bold uppercase tracking-eyebrow text-gold">step 1 · the floor</div>
        <h3 class="mt-3 font-display text-2xl font-medium text-ink">Operator portal</h3>
        <p class="mt-3 text-sm leading-relaxed text-inkSoft">
          Pick MILL-01 or LATHE-02, hit "Report a problem," describe a
          breakdown, attach a photo if you like.
        </p>
        <div class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-ink underline decoration-gold decoration-2 underline-offset-4 group-hover:text-inkSoft">
          Open the operator portal <span class="font-mono text-xs">&rarr;</span>
        </div>
      </a>
      <a href="https://technician.maintenance.demo.tracebook.ai/login?user=tech%40demo.tracebook.ai&pass=password" target="_blank" rel="noreferrer"
         class="group rounded-lg border border-ink/15 bg-paper p-7 transition-shadow hover:shadow-lg">
        <div class="font-mono text-[11px] font-bold uppercase tracking-eyebrow text-gold">step 2 · maintenance</div>
        <h3 class="mt-3 font-display text-2xl font-medium text-ink">Technician portal</h3>
        <p class="mt-3 text-sm leading-relaxed text-inkSoft">
          Open the ticket you just filed and hit "Investigate with AI" —
          the session arrives already knowing the report and the photo.
        </p>
        <div class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-ink underline decoration-gold decoration-2 underline-offset-4 group-hover:text-inkSoft">
          Open the technician portal <span class="font-mono text-xs">&rarr;</span>
        </div>
      </a>
    </div>
    <p class="mt-8 text-center text-xs italic text-inkMute">
      Shared demo accounts — anything you file is visible to other
      visitors and cleared periodically.
    </p>
  </div>
</section>
</Base>
